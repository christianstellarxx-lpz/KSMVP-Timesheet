// KSMVP VA Tasks — data model
// All timestamps are stored in UTC and displayed in America/New_York (ET).
//
// DATABASE: PostgreSQL, for both local dev and production (e.g. Vercel).
// Use a hosted Postgres (Neon, Vercel Postgres, Supabase, …) and point
// DATABASE_URL at it — the same URL works locally and in production.
//
// Roles/status are stored as validated strings (not DB enums), hours are Float,
// and workDate is a plain DateTime anchored to ET-midnight UTC. See src/lib/time.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Uses the DIRECT (non-pooled) connection for both runtime and migrations —
  // simplest and most reliable at this scale. Vercel/Neon's integrated Postgres
  // sets DATABASE_URL_UNPOOLED automatically; for an external database, point it
  // at your connection string. The same value works locally and in production.
  url      = env("DATABASE_URL_UNPOOLED")
}

// Role values: "ADMIN" | "VA_ADMIN" | "VA" | "INTERN"   (see src/lib/session.ts)
// EntryStatus values: "OPEN" | "CLOSED" | "INCOMPLETE"

model User {
  id           String   @id @default(cuid())
  role         String
  name         String
  title        String   @default("") // job position, e.g. "Chief Executive Officer"
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  // Reserved for future per-manager assignment; not used for scoping today
  // (the admin dashboard is org-wide). Kept as a self-relation.
  clientId String?
  client   User?   @relation("ClientVAs", fields: [clientId], references: [id], onDelete: SetNull)
  vas      User[]  @relation("ClientVAs")

  // Time entries this user (as a VA) owns.
  timeEntries TimeEntry[] @relation("VAEntries")

  // Comments this user (as an admin / VA admin) has written on entries.
  authoredComments Comment[] @relation("CommentAuthor")

  // Daily Flappy Bird scores (VA dashboard game).
  gameScores GameScore[] @relation("GameScores")

  // Daily Word Guess attempts (one per puzzle day).
  wordEntries WordEntry[] @relation("WordEntries")

  // Replay-verified mini-game runs (Stretch Goal and any future game that
  // scores a run server-side from its input log).
  miniGameRuns MiniGameRun[] @relation("MiniGameRuns")

  // Sales-desk notices this user sent (Sales Producer) / received (team channel).
  sentNotices     Notice[] @relation("NoticeSender")
  receivedNotices Notice[] @relation("NoticeRecipient")

  @@index([clientId])
  @@index([role])
}

model TimeEntry {
  id   String @id @default(cuid())
  vaId String
  va   User   @relation("VAEntries", fields: [vaId], references: [id], onDelete: Cascade)

  // The ET calendar day this entry belongs to (stored at ET-midnight, UTC-normalized).
  // Used for grouping/sorting so entries near midnight land on the intended day.
  workDate DateTime

  timeIn      DateTime? // UTC; null until set
  timeOut     DateTime? // UTC; null until closed
  hoursWorked Float? // computed on close; null while open/incomplete

  startOfDayTasks String
  urgentNeed      String? // null / empty => no urgent flag
  endOfDayTasks   String? // null until closed

  // "WORK" (a clocked shift) | "PTO" (paid time off / vacation, credited 8h)
  entryType String   @default("WORK")
  status    String   @default("OPEN") // OPEN | CLOSED | INCOMPLETE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Scheduled publish time (UTC) for the End-of-Day report — the "Atake"
  // scheduler. When set and still in the future, the entry is held back from
  // the admin dashboard until this instant (5:00 PM ET on the work date).
  // Null = visible to admins immediately (PTO, resolved stale sessions, and any
  // entries created before this feature).
  publishAt DateTime?

  // Admin feedback on this entry's start-of-day / end-of-day report.
  comments Comment[]

  @@index([vaId, workDate])
  @@index([status])
  // Fast lookup / integrity for the "at most one OPEN entry per VA" guard.
  // Enforced at the application layer inside a transaction; see src/lib/timeEntries.ts.
  @@index([vaId, status])
  @@index([publishAt])
}

// A note an admin (or VA admin) leaves on a VA's time entry. The VA sees it as
// feedback on their dashboard; `readAt` stays null until they've viewed it,
// which drives the "new comment" notification.
model Comment {
  id      String    @id @default(cuid())
  entryId String
  entry   TimeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  // Which part of the entry this is about: "START" | "END" | "GENERAL".
  target String @default("GENERAL")
  body   String

  readAt    DateTime? // null until the VA has seen it
  createdAt DateTime  @default(now())

  @@index([entryId])
  @@index([authorId])
}

// A daily Flappy Bird score. One row per user per ET day (they play once a day
// after clocking in). `playDate` is the ET calendar day at UTC-midnight, like
// TimeEntry.workDate. The all-time best per user powers the leaderboard.
model GameScore {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("GameScores", fields: [userId], references: [id], onDelete: Cascade)

  score    Int
  playDate DateTime // the ET day this score was set (one play per day)

  // Which game wrote this row. Every existing row is Daily Flappy — this table
  // has only ever held Flappy scores (the Word game stores guesses in
  // WordEntry, and Stretch Goal stores replays in MiniGameRun), so the
  // migration backfills "flappy" rather than inventing a different provenance.
  gameKey String @default("flappy")

  createdAt DateTime @default(now())

  @@unique([userId, playDate])
  @@index([score])
  @@index([gameKey])
}

// ---------------------------------------------------------------------------
// Daily Word Guess (monthly rotating game #2) — see src/lib/word/
// ---------------------------------------------------------------------------

// One puzzle per ET calendar day, shared by everyone. The answer is chosen
// deterministically from the curated list (date-seeded, see src/lib/word/logic.ts)
// and materialized here on the first request of the day, so every user provably
// reads the identical word even if the list is later edited.
//
// `answer` lives server-side only — it is never included in any DTO sent to the
// client until that user's own attempt is finished.
model WordPuzzle {
  id String @id @default(cuid())

  // The ET calendar day this puzzle is for (stored at UTC-midnight, like
  // TimeEntry.workDate / GameScore.playDate).
  date   DateTime @unique
  answer String // the 5-letter secret, lowercase

  // Phase 4 (multi-tenant) prep: nullable today, single-tenant in practice.
  organizationId String?

  createdAt DateTime @default(now())

  entries WordEntry[]

  @@index([organizationId])
}

// One VA's single attempt at one puzzle. The unique (vaId, puzzleId) constraint
// is what enforces "one attempt per VA per day" — the same shape as GameScore's
// (userId, playDate).
model WordEntry {
  id       String     @id @default(cuid())
  vaId     String
  va       User       @relation("WordEntries", fields: [vaId], references: [id], onDelete: Cascade)
  puzzleId String
  puzzle   WordPuzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  // JSON arrays, appended one entry per submitted guess and always the same
  // length: guesses = ["crane", …]; guessPatterns = [["grey","yellow", …], …].
  guesses       Json @default("[]")
  guessPatterns Json @default("[]")

  solved     Boolean @default(false)
  // 1–6 when solved, 0 when the attempt ended without a solve. While the
  // attempt is still in progress this tracks guesses used so far.
  guessCount Int     @default(0)

  // Set when the attempt is finalized (solved, or the 6th guess was used).
  completedAt DateTime?

  // Phase 4 (multi-tenant) prep: nullable today, single-tenant in practice.
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vaId, puzzleId])
  @@index([vaId])
  @@index([puzzleId])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Stretch Goal (monthly rotating game #3) — see src/lib/stretch/
// ---------------------------------------------------------------------------

// One ranked run of a replay-verified mini-game. Deliberately generic: any
// future game whose run compresses to a seed plus an input log reuses this
// table by picking a new `gameKey`.
//
// The row is created EMPTY at status "issued" the moment the server hands the
// player their seed, and filled in at status "submitted" once the replay has
// been verified. That two-phase shape is what makes the seed un-rerollable: a
// refresh reads back the seed already issued instead of minting a new one.
//
// `score`, `perfects` and `tier` are always the output of simulateRun() on the
// server. A client-supplied score is never read, let alone stored.
model MiniGameRun {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("MiniGameRuns", fields: [userId], references: [id], onDelete: Cascade)

  // "stretch-goal". Scopes the unique constraint so a future second game can
  // run alongside without colliding on the same day.
  gameKey  String
  // ET calendar month, "2026-09" — the season this run competes in.
  season   String
  // The ET calendar day (stored at UTC-midnight, like TimeEntry.workDate).
  // ET, not Manila: the timesheet's working day is the only definition of
  // "today" in this app and the game must not introduce a second one.
  playedOn DateTime

  // Issued by the server, never by the client, and never re-rolled. Kept inside
  // signed 32-bit range so it fits Postgres INTEGER without overflow.
  seed  Int
  // The replay input log: [{ press, release }, …]. Empty until submitted.
  holds Json @default("[]")

  // All three are simulateRun()'s output, computed server-side.
  score    Int @default(0)
  perfects Int @default(0)
  tier     Int @default(0)

  // REPLAY_VERSION at the time of the run. If the physics or the tier table
  // ever change, older rows are unverifiable rather than silently re-scored.
  replayVersion Int @default(0)

  // "issued"    — seed handed out, not yet played
  // "started"   — the player pressed Start. THE ATTEMPT IS NOW SPENT.
  // "submitted" — replay verified and scored; final.
  //
  // The jump to "started" is what makes this one try a day rather than one
  // *submission* a day. Consuming the attempt only on submit let a player
  // reload mid-run, get the same seed back and rehearse the identical layout
  // until they liked the result.
  status String @default("issued")

  startedAt   DateTime?
  submittedAt DateTime?

  // Phase 4 (multi-tenant) prep: nullable today, single-tenant in practice.
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // THE one-ranked-run-per-day rule. Enforced by the database, not the UI.
  @@unique([userId, gameKey, playedOn])
  @@index([gameKey, season])
  @@index([userId])
  @@index([organizationId])
}

// A message the Sales Producer sends to a fixed team channel from the Sales
// Desk. Each recipient gets their OWN row so per-person read state is
// independent — it shows on the recipient's dashboard (VA or admin) as a "new
// message" notice until they dismiss it (readAt set). No email is sent.
model Notice {
  id String @id @default(cuid())

  // Which channel it was sent to: "TECH_SUPPORT" | "ADMIN_INQUIRY".
  channel String
  body    String

  senderId String
  sender   User   @relation("NoticeSender", fields: [senderId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   User   @relation("NoticeRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  readAt    DateTime? // null until the recipient dismisses it
  createdAt DateTime  @default(now())

  @@index([recipientId, readAt])
  @@index([senderId])
}
