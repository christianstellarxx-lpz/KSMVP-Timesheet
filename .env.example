# ---------------------------------------------------------------------------
# KSMVP VA Tasks — environment variables
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# ---------------------------------------------------------------------------

# Database connection — PostgreSQL (used for BOTH local dev and production).
#
# Create a free hosted Postgres (Neon, Vercel Postgres, Supabase, …).
#   - DATABASE_URL_UNPOOLED : the DIRECT / non-pooled connection string. This is
#     what the app actually uses (see prisma/schema.prisma) — reliable at this
#     scale and free of connection-pooler quirks.
#   - DATABASE_URL          : kept for completeness / tooling; a pooled URL is
#     fine. If your provider gives only one string, set both to it.
#
# On Vercel/Neon's integrated Postgres, both are created automatically.
#
DATABASE_URL_UNPOOLED="postgresql://user:password@host/ksmvp?sslmode=require"
DATABASE_URL="postgresql://user:password@host/ksmvp?sslmode=require"

# Secret used to sign session (JWT) cookies. MUST be set and kept private.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# Note: every seeded account starts with the 4-digit PIN 0000 (see DEFAULT_PIN
# in src/lib/validation.ts). Members change their PIN in Account settings.

# Gemini — writes the past-tense End-of-Day draft from the VA's Start of Day.
# Optional: without a key the draft is just the Start-of-Day text to edit.
# Get a key at https://aistudio.google.com -> "Get API key". A project without
# billing stays on the free tier (Google may use and human-review free-tier
# requests, so keep sensitive client details out of task text).
GEMINI_API_KEY=""
# Optional — defaults to gemini-3.5-flash-lite.
GEMINI_MODEL="gemini-3.5-flash-lite"
